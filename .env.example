# =====================================================================
#  HegyesiHQ - Frappe ERP Stack  ::  .env sablon
# ---------------------------------------------------------------------
#  Portainerben: Stack -> Environment variables
#  A GitHubra CSAK ez a sablon kerul fel, a valodi .env SOHA.
#  Ellenorizd, hogy a .gitignore tartalmazza: .env
# =====================================================================

# ---------- Image es verzio ----------
IMAGE=ghcr.io/szricsi0917/frappe-erp-stack

# KOTELEZO es NEM lehet mozgo tag.
# Rossz:  TAG=v16
# Jo:     TAG=v16-20260828-a1b2c3d
TAG=v16-20260828-alap

# Ezeket is patch-szintre rogzitjuk, hogy ne valtozzanak csendben.
MARIADB_TAG=11.8.8
REDIS_TAG=7.4-alpine

# ---------- Site ----------
SITE_NAME=portal.hegyesihq.eu

# ---------- Titkok  ::  NE kerüljön GitHubra ----------
DB_PASSWORD=cseréld-ki-erős-jelszóra
ADMIN_PASSWORD=cseréld-ki-erős-jelszóra

# ---------- Utvonalak (Unraid) ----------
# FONTOS: a DB_DIR es a SITES_DIR a cache poolon van, amit a parity
# NEM ved. A mentesek es a feltoltott fajlok a tombon vannak.
DB_DIR=/mnt/cache/appdata/hegyesihq-engine/db-data
REDIS_QUEUE_DIR=/mnt/cache/appdata/hegyesihq-engine/redis-queue-data
SITES_DIR=/mnt/cache/appdata/hegyesihq-engine/sites
LOGS_DIR=/mnt/cache/appdata/hegyesihq-engine/logs

UPLOADS_PUBLIC_DIR=/mnt/user/HegyesiHQ/uploads/public
UPLOADS_PRIVATE_DIR=/mnt/user/HegyesiHQ/uploads/private

# VALTOZAS: a backups mar NEM az uploads/private ALATT van.
# Ez szunteti meg a matrjoska-jelenseget a mentesekben.
# A regi helyrol at kell mozgatni, mielott a stacket alkalmazod!
BACKUPS_DIR=/mnt/user/HegyesiHQ/backups

# ---------- Halozat ----------
HTTP_PORT=1701

# A valodi kliens-IP forrasa.
# Jelenlegi felallas (NPM -> host:1701 -> docker-proxy):
UPSTREAM_REAL_IP_ADDRESS=172.26.0.1
#
# B valtozat eseten (NPM a hegyesihq_network-on, kozvetlen proxy):
# UPSTREAM_REAL_IP_ADDRESS=172.26.0.0/16

# ---------- Teljesitmeny ----------
INNODB_BUFFER_POOL_SIZE=2G
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=100m

# ---------- Backup ----------
KEEP_BACKUPS_FOR_HOURS=744
